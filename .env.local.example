# Copy to .env.local and adjust for your environment.

# Supabase (required for production auth + database import)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Forecast engine (local dev)
NEXT_PUBLIC_FORECAST_API=http://localhost:8000

# Enable one-click demo login when Supabase is not configured (local dev only)
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true
